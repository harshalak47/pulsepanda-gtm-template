___TESTS___

scenarios:
- name: Loads the SDK with the site key
  code: |-
    let injected;
    mock('injectScript', (url, onSuccess) => { injected = url; onSuccess(); });
    runCode({ siteKey: ' abc123 ', captureDataLayer: false });
    assertThat(injected).isEqualTo('https://pulsepanda.dev/sdk.js?key=abc123');
    assertApi('gtmOnSuccess').wasCalled();
- name: Turns on dataLayer capture for every event
  code: |-
    let injected;
    mock('injectScript', (url, onSuccess) => { injected = url; onSuccess(); });
    runCode({ siteKey: 'abc123', captureDataLayer: true });
    assertThat(injected).isEqualTo('https://pulsepanda.dev/sdk.js?key=abc123&datalayer=true');
- name: Passes an event list
  code: |-
    let injected;
    mock('injectScript', (url, onSuccess) => { injected = url; onSuccess(); });
    runCode({ siteKey: 'abc123', captureDataLayer: true, dataLayerEvents: 'purchase,generate_lead' });
    assertThat(injected).isEqualTo('https://pulsepanda.dev/sdk.js?key=abc123&datalayer=purchase%2Cgenerate_lead');
- name: Reports a load failure
  code: |-
    mock('injectScript', (url, onSuccess, onFailure) => { onFailure(); });
    runCode({ siteKey: 'abc123' });
    assertApi('gtmOnFailure').wasCalled();


