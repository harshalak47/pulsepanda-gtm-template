___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const injectScript = require('injectScript');
const encodeUriComponent = require('encodeUriComponent');
const makeString = require('makeString');

const SDK_URL = 'https://pulsepanda.dev/sdk.js';

let url = SDK_URL + '?key=' + encodeUriComponent(makeString(data.siteKey).trim());
if (data.captureDataLayer) {
  const events = data.dataLayerEvents ? makeString(data.dataLayerEvents).trim() : '';
  url += '&datalayer=' + encodeUriComponent(events || 'true');
}

// The cache token makes GTM inject the SDK once per page, however often the tag fires.
injectScript(url, data.gtmOnSuccess, data.gtmOnFailure, 'pulsepanda-sdk');


